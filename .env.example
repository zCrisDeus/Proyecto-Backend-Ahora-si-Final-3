# Referencia: este ejemplo no se carga automáticamente.
# En AWS se lee /etc/petcare.env (640 root:ubuntu), ya preparado privadamente.
DJANGO_SECRET_KEY=GENERAR_UNA_CLAVE_PRIVADA_ESTABLE
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=petcare_db
DB_USER=petcare_admin
DB_PASSWORD=CONFIGURAR_PRIVADAMENTE
DB_HOST=localhost
DB_PORT=5432
MAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=PetCare <no-reply@example.invalid>
REMINDERS_ENABLED=False
REMINDER_ADVANCE_DAYS=1
# EC2: el servicio configura PETCARE_PUBLIC_IP_FILE=/run/petcare/public-ip
# Si luego hay dominio propio, definir PUBLIC_BASE_URL=https://dominio.example
# Envío real opcional:
# MAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP_HOST=servidor-del-proveedor
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=CONFIGURAR_PRIVADAMENTE
# SMTP_TLS=True
# SMTP_SSL=False
# REMINDERS_ENABLED=True
# Solo con certificado HTTPS funcionando:
# DJANGO_HTTPS=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dominio.example
